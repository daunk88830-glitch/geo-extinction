rules_version = '2';

/* Firestore 보안 규칙.
 *
 * 이 파일을 고친 뒤에는 반드시 서버에 올려야 반영됩니다.
 *
 *     npm run rules
 *
 * (처음 한 번만: npm run rules:login 으로 구글 로그인)
 * 콘솔에 손으로 붙여넣을 필요는 없습니다.
 *
 * 핵심 원칙
 *  1. 로그인(익명이라도)하지 않으면 아무것도 못 한다.
 *  2. 문서 이름 앞부분이 내 uid 인 문서만 쓸 수 있다 → 남의 데이터 조작 불가.
 *  3. 사건 점유(eventLocks)는 create 만 허용 → 먼저 누른 모둠이 이긴다.
 *  4. 판정(verdicts)은 그 사건을 점유한 모둠만 쓸 수 있다.
 *  5. 반(세션)이 다르면 자료가 섞이지 않는다 — 모든 것이 sessions/{반} 아래 있다.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    /* "uid_무엇" 형태의 문서 이름에서 앞부분이 내 uid 인지.
       split('_')[0] 로 하면 uid 안에 밑줄이 들어 있는 경우 검사가 뚫립니다.
       앞에서부터 uid 길이만큼 잘라 그대로 비교하는 편이 안전합니다. */
    function ownsDocId(id) {
      return id.size() > uid().size()
        && id[0:uid().size()] == uid()
        && id[uid().size():uid().size() + 1] == '_';
    }

    /* 내 모둠 번호. 명단에 내가 없으면 -1 을 돌려줍니다.
       없는 문서에 .data 를 쓰면 규칙 평가 자체가 오류로 끝나서,
       어떤 조건 때문에 막혔는지 알 수 없는 permission-denied 가 됩니다.
       -1 로 두면 "모둠이 안 맞아서 막혔다"로 깔끔하게 떨어지고,
       앱이 명단에 다시 등록한 뒤 재시도할 수 있습니다. */
    function myGroup(sid) {
      return exists(/databases/$(database)/documents/sessions/$(sid)/students/$(uid()))
        ? get(/databases/$(database)/documents/sessions/$(sid)/students/$(uid())).data.groupId
        : -1;
    }

    /* 교사인지. 최상위 teachers/{uid} 문서가 있으면 교사입니다.
       이 문서는 Firebase 콘솔에서 손으로 만듭니다(아래 teachers 규칙이 쓰기를 막습니다).
       서비스 계정 키를 외부에 두지 않고 교사 권한을 주기 위한 장치입니다.

       세션(반) 안이 아니라 최상위에 두는 이유: 반이 9개인데 세션마다
       교사 문서를 만들면 9번 등록해야 합니다. 교사는 반과 무관하게
       교사이므로 문서 하나로 모든 반을 봅니다. */
    function isTeacher() {
      return exists(/databases/$(database)/documents/teachers/$(uid()));
    }

    function lockedByMyGroup(sid, eventId) {
      return exists(/databases/$(database)/documents/sessions/$(sid)/eventLocks/$(eventId))
        && get(/databases/$(database)/documents/sessions/$(sid)/eventLocks/$(eventId)).data.groupId
           == myGroup(sid);
    }

    match /sessions/{sid} {
      allow read: if signedIn();
      allow write: if false;              // 세션 문서 자체는 콘솔에서만 만듭니다

      /* 학생 명단 — 본인 문서만 쓸 수 있고, 지울 수는 없습니다. */
      match /students/{studentDoc} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && studentDoc == uid()
          && request.resource.data.uid == uid()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.studentId is string
          && request.resource.data.studentId.size() <= 10
          && request.resource.data.groupId is int
          && request.resource.data.groupId >= 1
          /* 실제 모둠 수는 src/data/groups.js 가 정합니다(지금은 5).
             여기는 말도 안 되는 값만 막는 느슨한 상한입니다 — 딱 맞게 조이면
             나중에 모둠 수를 늘렸을 때 규칙을 같이 안 고쳐서 학생이
             "저장 권한이 없습니다"로 수업 시작부터 막히게 됩니다.
             모둠 번호는 보안 경계가 아닙니다(학생이 아무 번호나 고를 수 있음). */
          && request.resource.data.groupId <= 9;
        allow delete: if false;
      }

      /* 다양성 곡선 위의 탭. 문서 1개 = 학생 1명의 표시 1개.
         문서 이름이 {uid}_{binId} 라서 30명이 동시에 써도 서로 다른 문서입니다.
         → 한 문서에 몰리는 쓰기 경합이 원천적으로 없습니다.
         → 학급 히트맵은 이 컬렉션을 읽어 클라이언트에서 세면 됩니다.
            (증가 카운터 문서를 만들면 그 문서 하나에 30명이 몰려 병목이 됩니다.) */
      match /marks/{markId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && ownsDocId(markId)
          && request.resource.data.uid == uid()
          && request.resource.data.binId is string;
        allow delete: if signedIn() && ownsDocId(markId);
        allow update: if false;           // 수정 대신 지우고 다시 만듭니다
      }

      /* 사건(대멸종 1~5) 점유. 한 모둠이 사건 하나를 통째로 맡습니다.
         create 만 허용하는 것이 곧 잠금장치입니다 — 두 모둠이 같은 순간에
         같은 사건을 눌러도 Firestore 가 하나만 성공시킵니다.
         사건이 5개뿐이라 수업 시작 직후 경쟁이 가장 치열한 지점입니다. */
      match /eventLocks/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == uid()
          && request.resource.data.groupId == myGroup(sid);
        allow update, delete: if false;   // 점유 해제는 교사만 (콘솔)
      }

      /* 판정 결과. 열람은 전체 공개, 쓰기는 그 사건을 점유한 모둠만.
         한 모둠 안에서 여러 명이 동시에 편집하므로 앱은 항상 merge 로 씁니다.
         가설별·기준별로 필드가 나뉘어 있어 서로 다른 곳을 만지면 충돌이 없습니다. */
      match /verdicts/{eventId} {
        allow read: if signedIn();

        /* 앱은 항상 바뀐 부분만 merge 로 보냅니다. 예를 들어 가설 하나의
           판정만 고치면 payload 에 scores 나 status 가 들어 있지 않습니다.
           그래서 각 항목은 "보냈다면 형식이 맞아야 한다"로 검사합니다.
           무조건 존재를 요구하면 부분 저장이 전부 거부됩니다. */
        allow create, update: if signedIn()
          && lockedByMyGroup(sid, eventId)
          && request.resource.data.eventId == eventId
          && request.resource.data.groupId == myGroup(sid)
          && (!('status' in request.resource.data)
              || request.resource.data.status in ['draft', 'submitted'])
          && (!('screen' in request.resource.data)
              || request.resource.data.screen.keys().hasOnly(['H1', 'H2', 'H3', 'H4']))
          && (!('scores' in request.resource.data)
              || request.resource.data.scores.keys().hasOnly(['C1', 'C2', 'C3', 'C4']))
          && (!('reasons' in request.resource.data)
              || request.resource.data.reasons.keys().hasOnly(['C1', 'C2', 'C3', 'C4']));
        allow delete: if false;
      }

      /* 선개념 확인 응답. 문서 이름은 {uid}_pre 또는 {uid}_post.
         목록 읽기를 모든 학생에게 열어 둡니다 — 각자의 화면이 반 전체
         오개념 분포를 계산해 안내 카드를 재구성해야 하기 때문입니다.
         그래서 이 문서에는 이름·학번을 넣지 않습니다. uid 와 모둠번호뿐이라
         목록이 열려도 누가 무엇을 골랐는지 드러나지 않습니다.
         (교사는 uid 로 students 와 맞춰 봅니다) */
      match /preconceptions/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && ownsDocId(docId)
          && request.resource.data.uid == uid()
          && request.resource.data.phase in ['pre', 'post']
          && request.resource.data.answers is map;
        allow delete: if false;
      }

      /* 형성평가 답안.
         쓰기는 본인만. 읽기는 본인(get) 또는 교사(list) 입니다.
         get 과 list 를 나눈 이유: 학생이 컬렉션 전체를 훑으면 친구의 답안이
         딸려 나옵니다. list 를 교사에게만 열면 그 경로가 막힙니다. */
      match /quizAnswers/{ansId} {
        allow get: if signedIn() && (ownsDocId(ansId) || isTeacher());
        allow list: if signedIn() && isTeacher();
        allow create, update: if signedIn() && ownsDocId(ansId);
        allow delete: if false;
      }
    }

    /* 교사 명단 — 반과 무관한 최상위 컬렉션.
       콘솔에서만 만듭니다. 앱은 절대 쓰지 못합니다. */
    match /teachers/{teacherId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 위에서 명시하지 않은 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
